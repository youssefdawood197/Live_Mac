<Page
    x:Class="Live.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="16" MaxWidth="800">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Power Management Preferences Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Energy &amp; Power Optimization" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Header="Pause playback when a fullscreen application is focused"
                        IsOn="{x:Bind ViewModel.PauseOnFullscreen, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="Pause playback when operating on battery power"
                        IsOn="{x:Bind ViewModel.PauseOnBattery, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="Pause playback immediately when displays enter sleep mode"
                        IsOn="{x:Bind ViewModel.PauseOnDisplaySleep, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="About Lively Wallpaper Windows" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Version 1.0.0 (Windows Edition)" />
                    <TextBlock Text="Built with .NET 8.0, C# 12, WinUI 3, Win2D, and CsWin32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
