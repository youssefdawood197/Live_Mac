<UserControl
    x:Class="Live.App.Views.WindCompassControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
        <!-- Circular Dial Canvas -->
        <Border Grid.Column="0" Width="140" Height="140" CornerRadius="70"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2"
                Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid>
                <!-- Compass Cardinal Labels -->
                <TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="W" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="E" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" />

                <!-- Needle Indicator Line -->
                <Canvas x:Name="NeedleCanvas" Width="140" Height="140">
                    <Line x:Name="NeedleLine" X1="70" Y1="70" X2="70" Y2="25"
                          Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle" />
                </Canvas>
                <Ellipse Width="10" Height="10" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Angle & Speed Sliders -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Wind Direction:" FontWeight="SemiBold" />
                <TextBlock x:Name="AngleText" Text="{x:Bind WindAngleDegrees, Mode=OneWay}" />
                <TextBlock Text="°" />
            </StackPanel>
            <Slider
                x:Name="AngleSlider"
                Minimum="0" Maximum="360" StepFrequency="1"
                Value="{x:Bind WindAngleDegrees, Mode=TwoWay}"
                ValueChanged="AngleSlider_ValueChanged" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Wind Velocity Multiplier:" FontWeight="SemiBold" />
                <TextBlock x:Name="SpeedText" Text="{x:Bind WindSpeed, Mode=OneWay}" />
                <TextBlock Text="x" />
            </StackPanel>
            <Slider
                x:Name="SpeedSlider"
                Minimum="0" Maximum="3" StepFrequency="0.1"
                Value="{x:Bind WindSpeed, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</UserControl>
