<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Live.App</RootNamespace>
    <AssemblyName>Live.App</AssemblyName>
    <Description>WinUI 3 Fluent Desktop application and system tray companion for Lively Wallpaper Windows</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls" Version="7.1.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.0.124" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Live.Core\Live.Core.csproj" />
    <ProjectReference Include="..\Live.Interop.Win32\Live.Interop.Win32.csproj" />
    <ProjectReference Include="..\Live.Engine.Flake\Live.Engine.Flake.csproj" />
    <ProjectReference Include="..\Live.Engine.Video\Live.Engine.Video.csproj" />
    <ProjectReference Include="..\Live.Engine.Web\Live.Engine.Web.csproj" />
  </ItemGroup>

</Project>
